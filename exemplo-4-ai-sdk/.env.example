PORT=3004
DATABASE_PATH=data/app.db

# Opção A: modelo local via Ollama (padrão)
AI_PROVIDER=ollama
AI_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Opção B: Anthropic
# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...

# Máximo de voltas do loop do agente por mensagem
AI_MAX_STEPS=8
